menu "MS2109 wireless display"
    config CAPTURE_AUDIO
        bool "Capture MS2109 HDMI audio"
        default y
    config CAPTURE_AUDIO_SPEAKER
        bool "Play HDMI audio through the Korvo speaker codec"
        depends on CAPTURE_AUDIO
        default y
    config CAPTURE_AUDIO_VOLUME
        int "Initial device speaker volume (%)"
        default 35
        range 0 100
    config CAPTURE_LOG_KB
        int "Recent browser log buffer (KiB)"
        default 16
        range 4 64
    config CAPTURE_STREAM_SEND_MS
        int "Maximum MJPEG frame send time (ms)"
        default 250
        range 100 2000
        help
            Disconnect stalled stream clients rather than accumulating old video.
            Use a lower capture resolution if the link cannot sustain this budget.
    choice CAPTURE_PROFILE
        prompt "Capture profile"
        default CAPTURE_PROFILE_HD
        config CAPTURE_PROFILE_HD
            bool "1280x720 MJPEG at 30 fps (widescreen HDMI)"
        config CAPTURE_PROFILE_VGA
            bool "640x480 MJPEG at 30 fps (4:3 source)"
        config CAPTURE_PROFILE_CUSTOM
            bool "Custom advertised mode"
    endchoice
    config CAPTURE_WIDTH
        int "UVC capture width"
        depends on CAPTURE_PROFILE_CUSTOM
        default 640
        range 160 1280
    config CAPTURE_HEIGHT
        int "UVC capture height"
        depends on CAPTURE_PROFILE_CUSTOM
        default 480
        range 120 720
    config CAPTURE_FPS
        int "Capture FPS (0 uses card default)"
        depends on CAPTURE_PROFILE_CUSTOM
        default 0
        range 0 60
    config CAPTURE_FRAME_KB
        int "Maximum compressed frame size (KiB)"
        default 512
        range 128 2048
    config CAPTURE_VID
        hex "USB vendor ID (0 accepts any UVC device)"
        default 0x0
    config CAPTURE_PID
        hex "USB product ID (0 accepts any UVC device)"
        default 0x0
    config CAPTURE_MS2109_HEADERS
        bool "Strip MS2109 continuation headers for known MS2109 IDs"
        default y
        help
            Applies only to 534d:2109 and 345f:2109 MJPEG devices using
            16384-byte bulk URBs. See components/usb_host_uvc/PATCHES.md.
endmenu
